LLM_API_KEY=你的API_KEY
LLM_API_URL=https://api.tourmaster.ch/v1beta/models/gemini-3.1-flash-lite:generateContent
# Optional: set this on Render to use persistent PostgreSQL.
DATABASE_URL=
# Optional PostgreSQL schema. All database layers use the same value.
DATABASE_SCHEMA=public
# Optional: local SQLite path when DATABASE_URL is empty.
DB_PATH=data/city.db
# Set false for local/read-only instances connected to a shared production database.
WORLD_RUNNER_ENABLED=true
# Running ticks older than this are treated as abandoned and marked failed.
WORLD_STALE_TICK_SECONDS=90
# Maximum wait for one LLM request; failed calls fall back to deterministic rules.
LLM_REQUEST_TIMEOUT_SECONDS=20
# Keep scheduled world ticks deterministic and fast; enable only after LLM latency is monitored.
WORLD_RUNTIME_USE_LLM=false
WORLD_RUNTIME_MARKET_TICK_ENABLED=false
WORLD_RUNTIME_RESILIENCE_TICK_ENABLED=false
WORLD_RUNTIME_EXTENDED_SUBSYSTEMS_ENABLED=false
# Optional but recommended: protects World Runtime admin endpoints.
ADMIN_TOKEN=
# local, development, test, staging, or production. Non-local environments require ADMIN_TOKEN.
APP_ENV=local
# Per-client write limit for staging and production API requests.
WRITE_RATE_LIMIT_PER_MINUTE=60
